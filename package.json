    "content:validate": "node tools/content/validate.mjs",
    "schema:test": "node --experimental-strip-types lib/schema/ids.test.ts",
    "gsc:sites": "node --env-file=.env tools/gsc/export.mjs sites",
    "gsc:pages": "node --env-file=.env tools/gsc/export.mjs pages",
    "gsc:queries": "node --env-file=.env tools/gsc/export.mjs queries",
    "gsc:snapshot": "node --env-file=.env tools/gsc/export.mjs snapshot",
    "gsc:decay": "node tools/gsc/decay.mjs",
