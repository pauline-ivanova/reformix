# Reformix Barcelona — environment variables
# Copy to `.env.local` for local dev. Never commit secrets.
# Set the same keys in Vercel → Project → Settings → Environment Variables
# (Production + Preview; Development optional).

# ── Site ──────────────────────────────────────────────
# No trailing slash; avoid copy-paste newlines (breaks sitemap <loc>).
NEXT_PUBLIC_SITE_URL=https://www.reformix.barcelona

# ── Analytics (consent-gated except CF Web Analytics) ─
# Create GA4 property → Admin → Data streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Clarity → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Cloudflare Web Analytics → Manage site → JS snippet token (cookieless RUM)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# Phase F only (Meta ads trigger)
# NEXT_PUBLIC_META_PIXEL_ID=

# ── Turnstile (Cloudflare) ────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Sentry (errors · EU ingest · no Session Replay) ───
# Create org on reformix.barcelona@gmail.com with EU data residency.
# DSN must use ingest.de.sentry.io (see docs/phase-b-owner.md).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token with project:releases (+ org:read) for source maps upload (Vercel build + CI)
SENTRY_AUTH_TOKEN=
# Optional: send events from local `next dev` (off by default).
# Server reads SENTRY_ENABLE_DEV; the browser only sees NEXT_PUBLIC_* —
# set BOTH for full local smoke (API + /sentry-smoke client).
# SENTRY_ENABLE_DEV=true
# NEXT_PUBLIC_SENTRY_ENABLE_DEV=true
# Optional: personal token with event:read + project:read for local CLI Issues checks
# (org token vercel-sourcemaps is org:ci only — cannot list Issues). Do not put on Vercel.
# SENTRY_READ_TOKEN=

# ── Leads: Resend + Telegram ──────────────────────────
RESEND_API_KEY=
# Must be a verified domain sender, not onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@reformix.barcelona
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GSC local tooling (Phase E · optional on Vercel) ───
# Service account JSON path (default: secrets/gsc-service-account.json)
# GSC_CREDENTIALS_PATH=secrets/gsc-service-account.json
# Property URL as shown in Search Console (domain or URL-prefix)
# GSC_SITE_URL=sc-domain:reformix.barcelona
# GSC_SNAPSHOT_DAYS=28
# GSC_DECAY_MIN_IMPRESSIONS=50
